{
  "specVersion": "1.0",
  "host": {
    "displayName": "Доступный контент",
    "documentationUrl": "https://not-domain.ru/",
    "logoUrl": "https://not-domain.ru/logo.svg?v=1"
  },
  "entries": [
    {
      "identifier": "urn:air:not-domain.ru:accessibility-scanner:http-api",
      "displayName": "Accessibility Scanner API",
      "type": "application/json",
      "data": {
        "name": "Accessibility Scanner API",
        "description": "Проверка доступности контента: изображения, PDF, ссылки, формы, таблицы. История и CI-гейт для пайплайна.",
        "baseUrl": "https://not-domain.ru/api",
        "authentication": {
          "type": "header",
          "name": "X-Client-ID",
          "description": "Анонимный идентификатор браузера, 8–64 символа. Обязателен для сканов, истории и отчётов."
        },
        "endpoints": [
          {
            "method": "GET",
            "path": "/health",
            "description": "Проверка, что сервис жив."
          },
          {
            "method": "POST",
            "path": "/scans",
            "description": "Запускает проверку. Тело: { url, depth }."
          },
          {
            "method": "GET",
            "path": "/scans",
            "description": "История проверок текущего X-Client-ID."
          },
          {
            "method": "DELETE",
            "path": "/scans",
            "description": "Очищает историю текущего X-Client-ID."
          },
          {
            "method": "GET",
            "path": "/scans/{id}",
            "description": "Полный отчёт по скану."
          },
          {
            "method": "GET",
            "path": "/scans/{id}/pdf",
            "description": "PDF-отчёт на языке скана или параметра lang."
          },
          {
            "method": "GET",
            "path": "/scans/{id}/gate",
            "description": "CI-гейт: 200 при прохождении порогов, 409 при провале."
          }
        ]
      },
      "description": "Сервис доступности по WCAG: alt, PDF, ссылки, формы, таблицы, история версий, diff, аналитика, JSON и CI-гейт.",
      "tags": ["accessibility", "wcag", "pdf", "crawler", "audit", "ci"],
      "capabilities": [
        "ScanWebsite",
        "CheckAltText",
        "CheckPdfAccessibility",
        "CheckLinks",
        "ScanHistory",
        "CIGate",
        "ExportJson"
      ],
      "representativeQueries": [
        "Проверить доступность сайта по WCAG",
        "Проверить alt у изображений и PDF на сайте",
        "Встроить проверку доступности в CI"
      ],
      "version": "0.1.0",
      "updatedAt": "2026-11-28T00:00:00Z"
    }
  ]
}
