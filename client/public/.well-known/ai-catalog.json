      "displayName": "Accessibility Scanner API",
      "type": "application/json",
      "data": {
        "name": "Accessibility Scanner API",
        "description": "Проверка доступности сайта: изображения, PDF, ссылки, формы, таблицы и заголовки.",
        "baseUrl": "https://not-domain.ru/api",
        "endpoints": [
          {
            "method": "GET",
            "path": "/health",
            "description": "Проверка состояния сервиса и наличия ИИ."
          },
          {
            "method": "POST",
            "path": "/scans",
            "description": "Запуск проверки сайта. Тело: { url, depth }."
          },
          {
            "method": "GET",
            "path": "/scans/{id}",
            "description": "Статус и находки проверки."
          },
          {
            "method": "GET",
            "path": "/scans/{id}/pdf",
            "description": "PDF-отчёт по проверке."
          }
        ]
      },
      "description": "Сервис проверки доступности контента по WCAG: alt, PDF, ссылки, формы, таблицы, заголовки.",
      "tags": ["accessibility", "wcag", "pdf", "crawler", "audit"],
      "capabilities": [
        "ScanWebsite",
        "CheckAltText",
        "CheckPdfAccessibility",
        "CheckLinks"
      ],
      "representativeQueries": [
        "проверить доступность сайта по WCAG",
        "найти изображения без alt и PDF без тегов"
      ],
